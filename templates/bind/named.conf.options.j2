// File automatically generated by dns-platform
// Do not edit manually in any way

options {
    directory "/var/cache/bind";

    // Listen on all interfaces (IPv4 and IPv6)
    listen-on { any; };
    listen-on-v6 { any; };

    // Authoritative-only server: allow public queries, disable all recursion and cache queries
    allow-query { any; };
    recursion no;
    allow-recursion { none; };
    allow-query-cache { none; };
    dnssec-validation no;

    // Prevent unauthorized zone transfers (AXFR/IXFR), dynamic updates, and NOTIFY messages
    allow-transfer { none; };
    allow-update { none; };
    notify no;

    // Hide server version and identity (CHAOS queries)
    version none;
    hostname none;
    server-id none;

    // Minimize response size and mitigate DNS amplification attacks
    minimal-responses yes;
    rate-limit {
        responses-per-second 10;
    };
};
